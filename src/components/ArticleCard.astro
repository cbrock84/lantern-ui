---
import type { ArticleData } from '../content.ts';

export interface Props {
  article: ArticleData;
  href: string;
}

const { article, href } = Astro.props;
const date = article.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<article class="flex flex-col overflow-hidden rounded-xl border border-site-border bg-site-surface transition hover:shadow-md">
  {article.heroImage && (
    <a href={href} tabindex="-1" aria-hidden="true">
      <img src={article.heroImage} alt="" class="aspect-[2/1] w-full object-cover" loading="lazy" width="800" height="400" />
    </a>
  )}
  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-site-display text-xl font-semibold leading-snug text-site-heading">
      <a href={href} class="hover:text-site-accent">{article.title}</a>
    </h3>
    <p class="mt-2 flex-1 text-sm text-site-muted">{article.description}</p>
    <p class="mt-4 text-xs text-site-muted">
      <time datetime={article.pubDate.toISOString()}>{date}</time>
      {article.sources.length > 0 && <span> · {article.sources.length} {article.sources.length === 1 ? 'source' : 'sources'} cited</span>}
    </p>
  </div>
</article>
