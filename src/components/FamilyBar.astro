---
/**
 * The family bar (owner decision D59): a thin Lantern Learn strip at the top
 * of every property, linking the umbrella, the imprints, the course
 * catalog and sign-in, so moving between the sites always works the same way.
 * Styled with plain CSS so the learning platform (no Tailwind) can use it too.
 */
import { FAMILY, UMBRELLA, imprints, type SiteKey } from '../network.ts';
import { BASE, PLATFORM } from '../brand.ts';

export interface Props {
  /** The property rendering the bar; 'platform' is learn.lanternlearn.com. */
  current: SiteKey | 'platform';
  /** Replace "Sign in" (e.g. with "My dashboard" when signed in on the platform). */
  account?: { label: string; href: string };
}

const { current, account = { label: 'Sign in', href: PLATFORM.signIn } } = Astro.props;
const umbrella = FAMILY[UMBRELLA];
const short = (name: string) => name.replace(/ Books$/, '');
const style = `--fb-bg:${BASE.bar};--fb-text:${BASE.barText};--fb-accent:${BASE.barAccent};`;
---
<nav class="ll-family-bar" aria-label="Lantern Learn family" style={style}>
  <div class="ll-fb-inner">
    <a class="ll-fb-home" href={umbrella.url} aria-current={current === UMBRELLA ? 'page' : undefined}>{umbrella.name}</a>
    <ul class="ll-fb-imprints">
      {imprints().map((s) => (
        <li><a href={s.url} aria-current={current === s.key ? 'page' : undefined}>{short(s.name)}</a></li>
      ))}
    </ul>
    <span class="ll-fb-gap"></span>
    <a class="ll-fb-link" href={PLATFORM.courses} aria-current={current === 'platform' ? 'page' : undefined}>Courses</a>
    <a class="ll-fb-account" href={account.href}>{account.label}</a>
  </div>
</nav>

<style>
  .ll-family-bar { background: var(--fb-bg); color: var(--fb-text); font: 500 13px/1.3 "Inter", system-ui, sans-serif; }
  .ll-fb-inner { max-width: 72rem; margin: 0 auto; padding: 6px 16px; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 18px; }
  @media (min-width: 640px) { .ll-fb-inner { padding: 6px 24px; } }
  /* Tap targets: at least 24px tall (WCAG 2.2 AA 2.5.8), 32px on phones. */
  .ll-family-bar a { color: inherit; text-decoration: none; border-radius: 4px; display: inline-flex; align-items: center; min-height: 24px; }
  .ll-family-bar a:hover { color: var(--fb-accent); }
  .ll-family-bar a:focus-visible { outline: 2px solid var(--fb-accent); outline-offset: 2px; }
  .ll-family-bar a[aria-current='page'] { color: var(--fb-accent); text-decoration: underline; text-underline-offset: 4px; }
  .ll-fb-home { font: 700 12px/1 "Cinzel", Georgia, serif; letter-spacing: 0.16em; text-transform: uppercase; color: var(--fb-accent) !important; }
  .ll-fb-imprints { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 16px; }
  .ll-fb-gap { flex: 1 1 0; }
  .ll-fb-account { border: 1px solid var(--fb-accent); color: var(--fb-accent) !important; padding: 3px 10px; border-radius: 999px !important; }
  @media (max-width: 560px) {
    .ll-fb-imprints { order: 3; flex-basis: 100%; }
    .ll-family-bar a { min-height: 32px; }
  }
</style>
