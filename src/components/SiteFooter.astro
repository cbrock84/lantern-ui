---
import type { SiteConfig } from '../types.ts';
import { getSite, UMBRELLA } from '../network.ts';
import FamilyLinks from './FamilyLinks.astro';

export interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;
const me = getSite(site.key);
const umbrella = getSite(UMBRELLA);
const year = new Date().getFullYear();
// The consent banner (D312) is on the page whenever a tracker is.
const hasTrackers = !!(site.analytics?.gaId || site.analytics?.metricoolHash);
// See SiteHeader: forwarded empty slots suppress fallback content.
const brandHtml = Astro.slots.has('brand') ? (await Astro.slots.render('brand')).trim() : '';
// Brand marks for known networks, matched on the link label. Unknown labels show as text.
// Pinterest and Facebook paths are Simple Icons (CC0).
const SOCIAL_ICONS: Record<string, string> = {
  pinterest:
    '<path fill="currentColor" d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z"/>',
  instagram:
    '<rect x="2.25" y="2.25" width="19.5" height="19.5" rx="5.5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.6" cy="6.4" r="1.3" fill="currentColor"/>',
  facebook:
    '<path fill="currentColor" d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/>',
};
---
<footer class="mt-24 rounded-t-[36px] bg-base-footer-bg text-base-footer-text font-base">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 text-sm sm:px-6 md:grid-cols-2 lg:grid-cols-4">
    <div>
      {brandHtml ? <Fragment set:html={brandHtml} /> : <p class="font-wordmark text-2xl font-extrabold tracking-tight">{me.name}</p>}
      <p class="mt-3 max-w-md opacity-80">{site.footerBlurb}</p>
    </div>
    {site.footerLinks.length > 0 && (
      <div>
        <p class="font-base text-base font-semibold">Explore</p>
        <ul class="mt-2 space-y-1">
          {site.footerLinks.map((l) => (
            <li><a href={l.href} class="hover:text-base-footer-accent">{l.label}</a></li>
          ))}
        </ul>
      </div>
    )}
    <FamilyLinks current={site.key} />
    {(site.contactEmail || site.social?.length) && (
      <div>
        <p class="font-base text-base font-semibold">Stay in touch</p>
        {site.contactEmail && (
          <p class="mt-2 opacity-80">
            <a href={`mailto:${site.contactEmail}`} class="underline hover:text-base-footer-accent">{site.contactEmail}</a>
          </p>
        )}
        {site.social?.length ? (
          <ul class="mt-3 flex flex-wrap items-center gap-4">
            {site.social.map((s) => {
              const icon = SOCIAL_ICONS[s.label.toLowerCase()];
              return icon ? (
                <li>
                  <a href={s.href} rel="noopener noreferrer me" aria-label={s.label} title={s.label} class="block opacity-80 hover:text-base-footer-accent hover:opacity-100">
                    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false" set:html={icon} />
                  </a>
                </li>
              ) : (
                <li><a href={s.href} rel="noopener noreferrer me" class="opacity-80 hover:text-base-footer-accent">{s.label}</a></li>
              );
            })}
          </ul>
        ) : null}
      </div>
    )}
  </div>
  <div class="border-t border-base-footer-text/15">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-4 text-xs opacity-80 sm:px-6">
      <p>
        © {year} {me.name}. All rights reserved.
        {me.role === 'imprint' && (
          <>
            <span aria-hidden="true" class="mx-1">·</span>
            A <a href={umbrella.url} class="font-semibold underline hover:no-underline">{umbrella.name}</a> imprint
          </>
        )}
      </p>
      <p class="flex flex-wrap gap-3">
        {site.legalLinks.map((l) => <a href={l.href} class="hover:text-base-footer-accent">{l.label}</a>)}
        {hasTrackers && <button type="button" data-ll-consent-open class="hover:text-base-footer-accent">Cookie settings</button>}
      </p>
    </div>
  </div>
</footer>
